{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": false,
        "noEmit": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "types": ["vite/client"],
        "baseUrl": ".",
        "paths": {
            "@/*": ["../../work/folia/folia-major-main/src/*"],
            "~/*": ["./src/*"]
        }
    },
    "include": ["src", "vite.config.ts", "vite.inject.config.ts"]
}
